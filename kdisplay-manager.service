[Unit]
Description=KDisplay Manager
# Start only after GNOME has brought up the compositor-side display stack.
After=graphical-session.target org.gnome.Shell@wayland.service gnome-session-x11-services-ready.target
Wants=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=kdisplay-manager service --apply-on-start
Restart=on-failure
RestartSec=2

[Install]
WantedBy=graphical-session.target
